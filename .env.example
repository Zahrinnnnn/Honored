# MetaApi
META_API_TOKEN=
HFM_ACCOUNT_ID=

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# News calendar uses ForexFactory XML — no API key needed
# (Finnhub economic calendar requires a paid plan; ForexFactory is free)

# Your WhatsApp number (set in openclaw.json too)
USER_WHATSAPP_NUMBER=+601XXXXXXXXX

# Trading mode — true = paper (safe default), false = live
PAPER_MODE=true

# DB path override (optional — defaults to paper.db or honored.db based on PAPER_MODE)
# HONORED_DB_PATH=honored.db
